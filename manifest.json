{
  "manifest_version": 3,
  "name": "AUBIEETERNAL — Sovereign Intelligence",
  "version": "68.0",
  "description": "Turn any web content into family wisdom. Steelman, score, and teach — powered by your local sovereign AI.",
  "icons": {
    "16":  "icons/eagle16.png",
    "32":  "icons/eagle32.png",
    "48":  "icons/eagle48.png",
    "128": "icons/eagle128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AUBIEETERNAL 🦅",
    "default_icon": {
      "16": "icons/eagle16.png",
      "32": "icons/eagle32.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.substack.com/*",
        "https://*.medium.com/*",
        "https://news.ycombinator.com/*",
        "https://*.reddit.com/*",
        "https://*.youtube.com/*",
        "http://localhost:*/*",
        "https://*.local/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8502/*",
    "http://127.0.0.1:8502/*"
  ],
  "commands": {
    "analyze-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Analyze selected text with AUBIEETERNAL"
    }
  }
}
